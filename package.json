    "cf": "^1.0.0-beta.20",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.1-beta",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  }
