{
  "name": "v2echo-notifier-cf",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "tsc -b && tsc -p tsconfig.worker.json && cf build",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "oxlint",
    "db:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --persist-to .cloudflare/state",
    "setup": "node scripts/self-host.mjs setup",
    "update": "node scripts/self-host.mjs update",
    "release:pack": "node scripts/pack-release.mjs",
    "predeploy": "node scripts/check-deployment.mjs",
    "deploy": "node scripts/self-host.mjs update"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
